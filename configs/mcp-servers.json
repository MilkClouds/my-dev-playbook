{
  "mcpServers": {
    "context7": {
      "command": "pnpm",
      "args": ["dlx", "@upstash/context7-mcp"]
    },
    "perplexity": {
      "command": "pnpm",
      "args": ["dlx", "@perplexity-ai/mcp-server"],
      "env": { "PERPLEXITY_API_KEY": "<key>" }
    },
    "pdf-reader": {
      "command": "pnpm",
      "args": ["dlx", "@sylphx/pdf-reader-mcp"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer <token>" }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "notion-mcp-server": {
      "command": "pnpm",
      "args": ["dlx", "@notionhq/notion-mcp-server"],
      "env": { "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer <key>\", \"Notion-Version\": \"2025-09-03\"}" }
    },
    "outline": {
      "command": "pnpm",
      "args": ["--package=outline-mcp-server", "dlx", "outline-mcp-server-stdio"],
      "env": {
        "OUTLINE_API_KEY": "<key>",
        "OUTLINE_API_URL": "<url>"
      }
    }
  }
}
